# ==============================================================
# Wangs — Naga Pickle Marketplace (wangs.in) Environment Variables
# ==============================================================

# Django Core
SECRET_KEY=django-insecure-replace-this-with-a-random-secure-secret-key-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,wangs.in,*.wangs.in,*.onrender.com

# Database (PostgreSQL for Production / Render, defaults to local SQLite if unset)
DATABASE_URL=postgresql://wangs_user:wangs_password@localhost:5432/wangs_db

# Payment Gateway (Razorpay Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# CORS
CORS_ALLOW_ALL_ORIGINS=True
