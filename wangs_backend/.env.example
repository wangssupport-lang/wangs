# Django Core
SECRET_KEY=django-insecure-replace-this-with-a-random-secure-secret-key-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,wangs.in,*.wangs.in,*.onrender.com

# Database (PostgreSQL for Production / Render, defaults to local SQLite if unset)
DATABASE_URL=postgresql://wangs_user:wangs_password@localhost:5432/wangs_db

# Payment Gateway (Razorpay Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# PayU India Payment Gateway & Marketplace Split Settlement Architecture
DEFAULT_PAYMENT_PROVIDER=PAYU
PAYU_MERCHANT_KEY=payu_test_merchant_key
PAYU_MERCHANT_SALT=payu_test_merchant_salt
PAYU_MODE=TEST
# Split settlements and live seller payouts remain safely disabled until PayU approval & activation
PAYU_SPLIT_SETTLEMENTS_ENABLED=False

